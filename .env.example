# What's My Profile — configuration. Copy to `.env` (gitignored) and fill in.
# Every key is optional: a connector that lacks its key is skipped, not fatal.
# Read by explicit path only (see src/profilelab/config.py) — never by search.

# --- who is being profiled -------------------------------------------------
# The subject label that every signal is attached to. Keep it a pseudonym if
# you ever intend to publish derived figures.
WMP_SUBJECT=me

# --- broadcast half: your public footprint ---------------------------------
# GitHub login to profile. The connector works unauthenticated (60 req/hr);
# a token raises the limit to 5000/hr. A bare read-only token is enough.
WMP_GITHUB_LOGIN=
GITHUB_TOKEN=

# --- inference half: models that profile you from public text --------------
# Phase 2. Whichever keys are present get polled; divergence between models is
# itself a finding, so breadth beats picking one.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
